---
import Base from '../layouts/Base.astro';
import { waLink } from '../config/site';
---
<Base title="Thank You | Your ABH" description="Thanks for contacting Your ABH." noindex>
  <section class="relative overflow-hidden bg-ink py-28 text-center sm:py-36">
    <div class="grid-bg absolute inset-0"></div>
    <div class="container-x relative">
      <div class="mx-auto grid h-20 w-20 place-items-center rounded-full bg-brand text-4xl text-white">✓</div>
      <h1 class="mt-8 text-4xl font-bold text-white sm:text-6xl">Thank you! We got it.</h1>
      <p class="mx-auto mt-5 max-w-xl text-lg text-muted">Our team will review your details and get back to you within 24 hours. Want to speed things up? Message us on WhatsApp.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href={waLink()} target="_blank" rel="noopener" class="btn-primary !px-8 !py-4">Chat on WhatsApp</a>
        <a href="/" class="btn-ghost !px-8 !py-4">Back to Home</a>
      </div>
    </div>
  </section>
</Base>
