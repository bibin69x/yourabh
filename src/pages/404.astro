---
import Base from '../layouts/Base.astro';
---
<Base title="Page Not Found | Your ABH" noindex>
  <section class="relative overflow-hidden bg-ink py-28 text-center sm:py-36">
    <div class="grid-bg absolute inset-0"></div>
    <div class="container-x relative">
      <p class="font-display text-8xl font-bold text-gradient">404</p>
      <h1 class="mt-4 text-3xl font-bold text-white sm:text-5xl">This page took a wrong turn.</h1>
      <p class="mx-auto mt-4 max-w-md text-muted">Let's get you back on track.</p>
      <div class="mt-8 flex flex-col justify-center gap-3 sm:flex-row">
        <a href="/" class="btn-primary">Go Home</a>
        <a href="/services" class="btn-ghost">View Services</a>
      </div>
    </div>
  </section>
</Base>
