---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

type Post = { url: string; frontmatter: { title: string; description: string; date: string; category?: string } };
const posts = Object.values(import.meta.glob<Post>('./*.md', { eager: true })).sort(
  (a, b) => +new Date(b.frontmatter.date) - +new Date(a.frontmatter.date)
);
---
<Base title="Digital Marketing Insights & Guides | Your ABH Blog" description="Practical guides on SEO, Google Ads, Meta Ads, social media and automation for businesses in Kerala, India and the GCC.">
  <PageHero
    eyebrow="Insights"
    title="Marketing insights that <span class='text-gradient'>actually help</span>"
    text="No fluff. Practical guides on SEO, ads, social and automation for growing businesses."
    crumbs={[{ href: '/blog', label: 'Insights' }]}
  />
  <section class="container-x py-20">
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((p) => (
        <a href={p.url} class="group flex flex-col rounded-3xl border border-slate-200 p-7 transition hover:-translate-y-1 hover:border-brand/40 hover:shadow-xl" data-reveal>
          <span class="text-xs font-bold tracking-widest text-brand uppercase">{p.frontmatter.category ?? 'Insights'}</span>
          <h2 class="mt-3 text-xl font-bold group-hover:text-brand">{p.frontmatter.title}</h2>
          <p class="mt-3 flex-1 text-slate-600">{p.frontmatter.description}</p>
          <p class="mt-6 text-sm text-slate-400">{new Date(p.frontmatter.date).toLocaleDateString('en-IN', { year: 'numeric', month: 'short', day: 'numeric' })}</p>
        </a>
      ))}
    </div>
  </section>
</Base>
