---
import Logo from './Logo.astro';
import { services } from '../data/services';
import { locations } from '../data/locations';
import { site, waLink } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="bg-ink text-white/70">
  <div class="container-x grid gap-12 py-16 md:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
    <div>
      <Logo />
      <p class="mt-5 max-w-sm text-sm leading-relaxed text-muted">{site.description}</p>
      <div class="mt-6 space-y-2 text-sm">
        <a href={`tel:${site.phoneRaw}`} class="block font-semibold text-white hover:text-brand">{site.phone}</a>
        <a href={waLink()} target="_blank" rel="noopener" class="block font-semibold text-white hover:text-brand">WhatsApp: {site.phone}</a>
        <a href={`mailto:${site.email}`} class="block font-semibold text-white hover:text-brand">{site.email}</a>
        <p class="text-muted">{site.hours}</p>
      </div>
    </div>
    <div>
      <p class="mb-4 text-xs font-bold tracking-widest text-white uppercase">Services</p>
      <ul class="space-y-2.5 text-sm">
        {services.map((s) => <li><a href={`/services/${s.slug}`} class="hover:text-white">{s.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="mb-4 text-xs font-bold tracking-widest text-white uppercase">Locations</p>
      <ul class="space-y-2.5 text-sm">
        {locations.map((l) => <li><a href={`/locations/${l.slug}`} class="hover:text-white">Digital Marketing in {l.name}</a></li>)}
      </ul>
    </div>
    <div>
      <p class="mb-4 text-xs font-bold tracking-widest text-white uppercase">Company</p>
      <ul class="space-y-2.5 text-sm">
        <li><a href="/about" class="hover:text-white">About</a></li>
        <li><a href="/work" class="hover:text-white">Our Work</a></li>
        <li><a href="/blog" class="hover:text-white">Insights</a></li>
        <li><a href="/contact" class="hover:text-white">Contact</a></li>
        <li><a href="/privacy-policy" class="hover:text-white">Privacy Policy</a></li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-6 pb-24 text-xs text-muted sm:flex-row sm:pb-6">
      <p>© {year} {site.name}. All rights reserved.</p>
      <p>Made in Kerala for brands everywhere.</p>
    </div>
  </div>
</footer>
