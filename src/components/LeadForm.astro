---
import { services } from '../data/services';
import { site } from '../config/site';
interface Props { title?: string; subtitle?: string; preselect?: string; dark?: boolean }
const {
  title = 'Get your free marketing audit',
  subtitle = 'We review your website, ads and social and send a growth plan within 48 hours. No obligation.',
  preselect = '',
  dark = false,
} = Astro.props;
const field = dark
  ? 'w-full rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-sm text-white placeholder:text-white/40 outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/30 [&>option]:text-ink'
  : 'w-full rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-ink placeholder:text-slate-400 outline-none transition focus:border-brand focus:ring-2 focus:ring-brand/20';
const label = `mb-1.5 block text-xs font-bold ${dark ? 'text-white/70' : 'text-slate-600'}`;
const uid = Math.random().toString(36).slice(2, 7);
---
<form class={`lead-form rounded-3xl p-6 sm:p-8 ${dark ? 'border border-white/10 bg-ink-2' : 'border border-slate-200 bg-white shadow-2xl shadow-ink/10'}`}
  data-key={site.web3formsKey} data-wa={site.whatsapp} novalidate>
  <h3 class={`text-2xl font-bold ${dark ? 'text-white' : 'text-ink'}`}>{title}</h3>
  <p class={`mt-1.5 mb-6 text-sm ${dark ? 'text-muted' : 'text-slate-500'}`}>{subtitle}</p>
  <input type="checkbox" name="botcheck" class="hidden" tabindex="-1" autocomplete="off" />
  <div class="grid gap-4 sm:grid-cols-2">
    <div><label class={label} for={`n-${uid}`}>Your name *</label><input id={`n-${uid}`} name="name" required class={field} placeholder="Full name" autocomplete="name" /></div>
    <div><label class={label} for={`p-${uid}`}>WhatsApp / Phone *</label><input id={`p-${uid}`} name="phone" type="tel" required class={field} placeholder="+91 / +971 …" autocomplete="tel" /></div>
    <div><label class={label} for={`e-${uid}`}>Email</label><input id={`e-${uid}`} name="email" type="email" class={field} placeholder="you@company.com" autocomplete="email" /></div>
    <div><label class={label} for={`w-${uid}`}>Website / Instagram</label><input id={`w-${uid}`} name="website" class={field} placeholder="yourbusiness.com" /></div>
    <div>
      <label class={label} for={`s-${uid}`}>I need help with *</label>
      <select id={`s-${uid}`} name="service" required class={field}>
        <option value="">Select a service</option>
        {services.map((s) => <option value={s.name} selected={s.slug === preselect}>{s.name}</option>)}
        <option value="Not sure / Full package">Not sure / Full package</option>
      </select>
    </div>
    <div>
      <label class={label} for={`b-${uid}`}>Monthly budget</label>
      <select id={`b-${uid}`} name="budget" class={field}>
        <option value="">Select range</option>
        <option>Under ₹25,000</option>
        <option>₹25,000 – ₹75,000</option>
        <option>₹75,000 – ₹2,00,000</option>
        <option>₹2,00,000+</option>
        <option>GCC / International: discuss</option>
      </select>
    </div>
    <div class="sm:col-span-2"><label class={label} for={`m-${uid}`}>Tell us about your goals</label><textarea id={`m-${uid}`} name="message" rows="3" class={field} placeholder="e.g. We want more leads for our clinic in Kochi"></textarea></div>
  </div>
  <button type="submit" class="btn-primary mt-6 w-full !py-4 text-base">Get My Free Audit →</button>
  <p class="form-status mt-3 hidden text-center text-sm font-semibold text-brand" role="status"></p>
  <p class={`mt-3 text-center text-xs ${dark ? 'text-white/40' : 'text-slate-400'}`}>We never share your details. Reply within 24 hours.</p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('.lead-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const status = form.querySelector<HTMLElement>('.form-status')!;
      const btn = form.querySelector<HTMLButtonElement>('button[type=submit]')!;
      const data = new FormData(form);
      if (data.get('botcheck')) return;
      if (!form.checkValidity()) {
        form.reportValidity();
        return;
      }
      const v = (k: string) => String(data.get(k) || '').trim();
      const summary = [
        'New enquiry from Your ABH website',
        '',
        `Name: ${v('name')}`,
        `Phone: ${v('phone')}`,
        `Email: ${v('email')}`,
        `Website: ${v('website')}`,
        `Service: ${v('service')}`,
        `Budget: ${v('budget')}`,
        `Page: ${location.pathname}`,
        '',
        v('message'),
      ].join('\n');

      btn.disabled = true;
      btn.textContent = 'Sending…';
      const key = form.dataset.key;
      let sent = false;
      if (key) {
        try {
          const res = await fetch('https://api.web3forms.com/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
            body: JSON.stringify({
              access_key: key,
              subject: `New lead: ${v('service') || 'Website enquiry'} (${v('name')})`,
              from_name: 'Your ABH Website',
              ...Object.fromEntries(data),
              page: location.href,
            }),
          });
          sent = (await res.json()).success === true;
        } catch {
          sent = false;
        }
      }
      (window as any).gtag?.('event', 'generate_lead', { service: v('service') });
      (window as any).fbq?.('track', 'Lead');

      if (sent) {
        location.href = '/thank-you';
      } else {
        // No form key yet (or it failed): send the lead straight to your WhatsApp.
        status.classList.remove('hidden');
        status.textContent = 'Opening WhatsApp to send your enquiry…';
        window.open(`https://wa.me/${form.dataset.wa}?text=${encodeURIComponent(summary)}`, '_blank');
        setTimeout(() => (location.href = '/thank-you'), 800);
      }
    });
  });
</script>
