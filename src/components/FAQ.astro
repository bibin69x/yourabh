---
interface Props { faqs: { q: string; a: string }[]; title?: string }
const { faqs, title = 'Frequently asked questions' } = Astro.props;
---
<section class="container-x py-20">
  <div class="grid gap-10 lg:grid-cols-[1fr_1.6fr]">
    <div>
      <span class="eyebrow border-brand/30 text-brand">FAQ</span>
      <h2 class="mt-4 text-3xl font-bold sm:text-4xl">{title}</h2>
      <p class="mt-3 text-slate-500">Still have questions? Message us on WhatsApp. We usually reply within the hour.</p>
    </div>
    <div class="divide-y divide-slate-200 border-y border-slate-200">
      {faqs.map((f) => (
        <details class="group py-5">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold [&::-webkit-details-marker]:hidden">
            {f.q}
            <span class="grid h-8 w-8 shrink-0 place-items-center rounded-full border border-slate-200 transition group-open:rotate-45 group-open:border-brand group-open:bg-brand group-open:text-white">+</span>
          </summary>
          <p class="mt-3 pr-12 leading-relaxed text-slate-600">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
